#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""CYCLE — тождественный вход в SOCC · ДОМ (единый хаб органов, read 0₽).

Движок один — socc_cli.home (канон). CYCLE лишь зовёт его диспетчер:

    CYCLE              → socc home        (дашборд: ЯМ · OZON · SUBSTRATE · ANNA · КЕРНЕЛЬ)
    CYCLE YM           → socc ym          (весь ЯМ-ЦИКЛ: ШТАБ · магазины · ДЕЛО · ЗАДАНИЯ)
    CYCLE YM дело      → ДЕЛО одним блоком
    CYCLE YM планёрка  → магазины + ЗАДАНИЯ
    CYCLE YM задания   → реестр заданий (открытые по важности)
    CYCLE YM штаб      → 13 ролей листом
    CYCLE YM мозг      → интерактивный МОЗГ (навигатор)
    CYCLE OZON         → OZON-менеджер (read-сводка)
    CYCLE substrate    → ENTITY SUBSTRATE
    CYCLE anna         → ANNA · дашборд · вход
    CYCLE kernel       → КЕРНЕЛЬ · route authority
    CYCLE --help       → справка

Ничего не пишет, сеть не зовёт. Цвет на живом tty, plain в пайпе (CC8-канон).
"""
from __future__ import annotations

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SOCC_ROOT = HERE.parents[2] if len(HERE.parents) > 2 else HERE.parents[-1]  # arbiter → mint → scripts → SOCC
# SOCC_ROOT от arbiter: arbiter/.parents[2] = scripts/mint/arbiter→mint→scripts? нет:
# parents: [0]=arbiter, [1]=mint, [2]=scripts, [3]=SOCC. Здесь файл лежит в arbiter.
# Уточняем по маркеру MEMORY_WAVE — канон.
for anc in (HERE, *HERE.parents):
    if (anc / "socc_cli").is_dir() and (anc / "MEMORY_WAVE").is_dir():
        SOCC_ROOT = anc
        break
if str(SOCC_ROOT) not in sys.path:
    sys.path.insert(0, str(SOCC_ROOT))
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

_USAGE = """CYCLE = socc home — единый read-хаб SOCC (0₽, ничего не пишет)
  CYCLE               — ДОМ (дашборд: ЯМ · OZON · SUBSTRATE · ANNA · КЕРНЕЛЬ)
  CYCLE YM            — весь ЯМ-ЦИКЛ одним экраном
  CYCLE YM дело|планёрка|задания|штаб|день|kpi|артефакты|авто|мозг
  CYCLE OZON|substrate|anna|kernel
  CYCLE --help        — справка
"""


def _main(argv=None):
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    try:
        from socc_cli.home import dispatch
    except Exception as e:  # pragma: no cover
        sys.stderr.write(f"CYCLE · socc_cli.home не импортировался: {e}\n")
        sys.stderr.write(_USAGE)
        return 2
    return dispatch(argv)


if __name__ == "__main__":
    sys.exit(_main())
