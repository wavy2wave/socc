# ========== ОБЯЗАТЕЛЬНО (минимум для запуска) ==========
WAVE_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WAVE_ADMIN_IDS=123456789

# ========== КАССЫ (добавляются поэтапно) ==========
# СБП — самый быстрый способ для РФ (1 тап в приложении банка)
# Карты, SberPay — через те же ключи ЮKassa

# ЮKassa (РФ-карты/СБП/SberPay) — нужен аккаунт yookassa.ru + ИП/самозанятость
# WAVE_YOOKASSA_SHOP_ID=123456
# WAVE_YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxx

# CryptoBot (крипта USDT/TON) — токен получить у @CryptoBot (/my_apps → Create App)
# WAVE_CRYPTO_PAY_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxx
# WAVE_CRYPTO_ASSET=USDT
# WAVE_CRYPTO_RUB_PER_UNIT=100

# Ручная оплата (реквизиты + оператор подтверждает кнопкой)
# WAVE_MANUAL_PAY_DETAILS=Карта Сбер 1234 5678 9012 3456\nИмя Фамилия

# ========== ПОРЯДОК КАСС (первая = первая кнопка в боте) ==========
# sbp      = СБП (отдельная кнопка, самое быстрое)
# card     = банковская карта (отдельная кнопка)
# sberpay  = SberPay (отдельная кнопка)
# yookassa = универсальная страница ЮKassa (все способы разом)
# stars    = Telegram Stars ⭐ (работает всегда, если есть токен бота)
# crypto   = крипта USDT/TON
# manual   = ручной перевод
WAVE_PAYMENT_ORDER=sbp,card,stars,crypto,manual

# ========== НАСТРОЙКИ ==========
WAVE_SHOP_NAME=WAVE SHOP
WAVE_SUPPORT_CONTACT=@wave_support
WAVE_CURRENCY=RUB
WAVE_REF_REWARD_PERCENT=10

# ========== ПОДПИСКИ (автопродление) ==========
# Бот сам списывает с привязанной карты, когда срок заканчивается.
# Клиент предупреждается заранее и может отключить одной кнопкой.
WAVE_AUTORENEW=1
WAVE_RENEW_NOTICE_DAYS=3

# ========== WAVE GATEWAY (шлюз доступа к ИИ) ==========
# ТВОЙ настоящий ключ провайдера. Клиенты его НИКОГДА не видят —
# шлюз подставляет его сам и выдаёт клиентам токены wave-...
# WAVE_UPSTREAM_KEY=sk-твой-ключ
# WAVE_UPSTREAM_URL=https://agentrouter.org/v1

# --- ОБОЙМА сырых ключей («дрова») ---
# Один ключ = точка отказа: кончился баланс — легли ВСЕ клиенты разом. Обойма
# держит СПИСОК ключей и на лету подхватывает следующий, когда текущий отвергнут
# (401/403 → мёртв навсегда) или перегрет (429 → пауза, потом снова годен).
#
# Заливать ключи проще всего файлом — по ОДНОМУ в строке. Файл дозаливается на
# лету, БЕЗ перезапуска шлюза («дрова»). Лежит в data/ и уже в .gitignore.
# Путь по умолчанию: data/upstream_pool.keys (создаётся с шапкой при старте).
# WAVE_UPSTREAM_POOL_FILE=data/upstream_pool.keys
#
# Либо стартовая засыпка списком через запятую (файл всё равно приоритетнее):
# WAVE_UPSTREAM_KEYS=sk-один,sk-два,sk-три
#
# Одиночный WAVE_UPSTREAM_KEY (выше) по-прежнему работает — он просто становится
# ещё одним патроном в обойме. Источники объединяются, дубликаты схлопываются.
#
# Пауза для перегретого ключа (429), сек. По умолчанию 60.
# WAVE_UPSTREAM_COOLDOWN_SEC=60
# Сколько патронов перебрать в рамках ОДНОГО запроса, прежде чем сдаться (503).
# По умолчанию 8; 0 = без ограничения (не рекомендуется).
# WAVE_UPSTREAM_MAX_ATTEMPTS=8

# Бренд ключа клиента: любой префикс из латиницы/цифр/-/_ (кириллица и пробелы
# вычищаются, мусор → 'wave-'). Ключ едет в HTTP-заголовок, поэтому только ASCII.
# Смена НЕ ломает уже выданные ключи — они ищутся по точному совпадению.
# WAVE_KEY_PREFIX=wave-

# Что показывать клиенту как адрес подключения (домен, когда появится)
WAVE_PUBLIC_GATEWAY=http://127.0.0.1:8790/v1
# WAVE_PUBLIC_DASHBOARD=http://127.0.0.1:8791

# Порты локально
WAVE_GW_PORT=8790
WAVE_DASH_PORT=8791

# Какие модели разрешены клиентам (пусто = все)
# WAVE_ALLOWED_MODELS=claude-opus-5,claude-opus-4-8

# ========== АВТОПРОДЛЕНИЕ ПО РАСПИСАНИЮ (cron, раз в час) ==========
# 0 * * * * cd /path/to/wave_shop && python3 renewals.py >> renewals.log 2>&1
