# SOCC · env.example
# Ключи — ТОЛЬКО здесь (env), в репо секретов нет (закон M2). Скопируйте в .env и заполните.
# Никогда не коммитьте .env (в .gitignore).

# ── ARBITER · ЯНДЕКС МАРКЕТ (ЦИКЛ-1) ─────────────────────────────────────
YANDEX_MARKET_API_KEY=
# кабинет Atlas / Экспресс-витрина / склад (манифест runtime/cycle1/stores.json)
YANDEX_BUSINESS_ID=
YANDEX_CAMPAIGN_ID=
YM_SHIFT_MEMORY=
YM_DAY_JOURNAL=
YM_REGISTRY_PATH=
YM_POINTS_PATH=
