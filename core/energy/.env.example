# SOCC energy library — your own keys only. Copy to .env and fill.
# A provider can hold a QUEUE of keys: PREFIX, then PREFIX_1, PREFIX_2, ...
# The vault issues them round-robin and burns/cools dead ones automatically.

# OpenRouter (recommended, RF-accessible, one key -> many free models)
OPENROUTER_KEY=
# OPENROUTER_KEY_1=
# OPENROUTER_KEY_2=

# DeepSeek (direct, RF-accessible)
DEEPSEEK_KEY=

# Mistral (Experiment free tier)
MISTRAL_KEY=

# Hugging Face (inference router)
HF_KEY=
